<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#101116"
    android:padding="24dp">

    <!-- LEFT SIDEBAR -->
    <LinearLayout
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦅 GARUDAX"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🏠  HOME"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🎮  PLAY"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🧩  MODS"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="✨  SHADERS"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📦  MODPACKS"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⚙️  SETTINGS"/>

    </LinearLayout>

    <!-- MAIN AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GARUDAX LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minecraft Mobile"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"/>

        <Spinner
            android:layout_width="300dp"
            android:layout_height="55dp"/>

        <Spinner
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"/>

        <Button
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:text="▶  PLAY MINECRAFT"
            android:textSize="20sp"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧩 Mods     ✨ Shaders     📦 Modpacks"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginTop="30dp"/>

    </LinearLayout>

</LinearLayout>
